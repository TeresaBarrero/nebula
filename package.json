{
  "name": "nebula",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tipos": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:rls": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.rls.config.mts",
    "comprobar": "npm run lint && npm run tipos && npm run test",
    "db:subir": "node scripts/db.mjs push",
    "db:tipos": "node scripts/db.mjs tipos",
    "hacer-admin": "node --env-file=.env.local scripts/hacer-admin.mjs",
    "iconos": "node scripts/generar-iconos.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
