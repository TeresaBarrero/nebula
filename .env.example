# Copia este archivo como .env.local y rellena los valores (nunca subas .env.local a GitHub).
# Dónde encontrarlos: Supabase → tu proyecto → Project Settings → API Keys / Data API.

# Dirección de tu proyecto de Supabase (empieza por https:// y acaba en .supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública («Publishable key», empieza por sb_publishable_). Se puede ver en el navegador; la seguridad la ponen las reglas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta («Secret key», empieza por sb_secret_). SOLO en tu ordenador para scripts y pruebas. NO la pongas en Vercel.
SUPABASE_SECRET_KEY=

# Opcional: dirección pública de la app (p. ej. https://nebula-xxx.vercel.app). Si no se pone, se deduce sola.
NEXT_PUBLIC_SITE_URL=
